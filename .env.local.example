# CareConnect Environment Variables

# Public Supabase Client (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Supabase Admin Key
# CRITICAL: This key MUST NEVER be prefixed with NEXT_PUBLIC_ or exposed to the browser.
# It is used exclusively in src/lib/supabase/admin.ts for administrative provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
